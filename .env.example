# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values. NEVER commit `.env`.
# All variables are validated with Zod at startup (see src/config/env.ts).
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
PORT=5000
# Every route is mounted under this prefix (must start with "/")
API_PREFIX=/api/v1

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/mern_starter

# JWT secrets: minimum 32 characters, and the two must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Format: <number><s|m|h|d>, e.g. 15m, 7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (CORS + password-reset links)
CLIENT_ORIGIN=http://localhost:3000
# Production: CLIENT_ORIGIN=https://ardor-final.netlify.app (see .env.production.example)

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ----------------------------- Optional settings ---------------------------
# bcrypt cost factor (10-14 is typical)
# BCRYPT_ROUNDS=12
# Max JSON / urlencoded body size
# BODY_LIMIT=100kb
# Global rate limit: requests per window per IP
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# Stricter limit for /auth endpoints (login, register, forgot-password, ...)
# AUTH_RATE_LIMIT_MAX=20
# Password reset link lifetime in minutes
# PASSWORD_RESET_EXPIRES_MINUTES=30
# Refresh-token cookie: SameSite policy (lax | strict | none) and optional domain.
# Use "none" only when the SPA is on a different site; it forces Secure cookies.
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
# Number of reverse proxies in front of the app (needed for correct client IPs)
# TRUST_PROXY=0
# File uploads: storage folder (relative to where the app starts), max size per
# file in MB, and max files per request. Keep the folder out of git and, in
# production, on a persistent volume.
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=5
# MAX_UPLOAD_FILES=10
# Swagger UI at <API_PREFIX>/docs. Defaults to true outside production.
# DOCS_ENABLED=true

# --------------------------- Development seed data -------------------------
# `npm run seed` (add `-- --reset` to wipe experts/appointments/enquiries first)
# creates these accounts. Defaults are dev-only; never use them in production.
# SEED_ADMIN_EMAIL=admin@ardor.test
# SEED_ADMIN_PASSWORD=Admin12345
# SEED_CLIENT_EMAIL=client@ardor.test
# SEED_CLIENT_PASSWORD=Client12345
