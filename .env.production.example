# ---------------------------------------------------------------------------
# Production values for api.ardorpsychology.com. Copy to `.env` on the server
# and fill in the secrets. NEVER commit the real file.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Website origin(s) allowed by CORS. The first one is used for password-reset links.
# Exact origins only: scheme + host, no path, no trailing slash.
CLIENT_ORIGIN=https://ardor-final.netlify.app

LOG_LEVEL=info

# The website (netlify.app) and the API (ardorpsychology.com) are different sites,
# so the refresh-token cookie must be SameSite=None (this also forces Secure).
COOKIE_SAME_SITE=none
# Leave empty: the cookie belongs to the API host.
COOKIE_DOMAIN=

# Behind one reverse proxy / load balancer (nginx, cPanel, Render, etc.)
TRUST_PROXY=1

DOCS_ENABLED=false
